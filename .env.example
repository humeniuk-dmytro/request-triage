# Скопіюйте у .env і заповніть. .env у .gitignore — ключі в репозиторій не потрапляють.

# --- LLM (обов'язково для реального прогону) ---------------------------------
# Ключ безкоштовного тіру: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель пінимо явно: "latest"-аліаси змінюються під ногами і ламають відтворюваність.
TRIAGE_MODEL=gemini-3.5-flash-lite

# --- Параметри прогону (усе має розумні дефолти) ------------------------------
# Скільки запитів обробляти одночасно.
TRIAGE_CONCURRENCY=5
# Ліміт звернень на хвилину — те, у що впирається реальний прогін.
# Семафор паралельності від цього не рятує: він обмежує одночасність, а квота
# рахує запити за хвилину. Ліміти безкоштовного тіру дуже різні між моделями
# (у gemini-2.5-flash — 5/хв і лише 20 на добу). Ловите 429 — знижуйте.
# 0 вимикає обмежувач (платний тір).
TRIAGE_RPM=10
# Скільки разів повторити виклик при транспортній помилці (429/5xx/таймаут).
TRIAGE_MAX_RETRIES=3
# Скільки разів просити модель виправити невалідний вивід. 1 — компроміс
# між надійністю і вартістю; докладніше в README.
TRIAGE_MAX_REPAIRS=1

# --- Опційно: Telegram-дайджест (прапорець --notify) --------------------------
# Немає токена → крок пропускається з попередженням, прогін не падає.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Опційно: Google Sheets (прапорець --sheets) ------------------------------
# Шлях до JSON service account + ID таблиці (з URL між /d/ та /edit).
# Таблицю треба розшарити на email сервісного акаунта з правом Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
# Скоупи через кому. За замовчуванням — рівно `spreadsheets`: доступ до
# конкретної таблиці дає її шеринг на email сервісного акаунта, а не ширші
# права. Ключ у файлі має відкривати один аркуш і нічого більше.
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets
